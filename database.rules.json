{
  "rules": {
    "samples": {
      ".read": "auth != null && auth.token.email === 'rugs@counter-room.local'",
      ".write": "auth != null && auth.token.email === 'rugs@counter-room.local'",
      "$sampleId": {
        "id": {
          ".validate": "newData.val() === $sampleId"
        },
        "status": {
          ".validate": "newData.val() === 'in-room' || newData.val() === 'issued'"
        }
      }
    }
  }
}
